APP_NAME="Qdesign Absensi Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# URL web Laravel — HARUS IP/hostname mesin yang menjalankan php artisan serve.
# Vite dev server (npm run dev:watch) otomatis pakai hostname dari APP_URL.
#
# PC utama / production (192.168.100.249):
APP_URL=http://192.168.100.249:8008
#
# Develop di PC lain, DB tetap di .249 (contoh PC dev 192.168.100.100):
# APP_URL=http://192.168.100.100:8008

# Opsional — override host Vite HMR. Biasanya tidak perlu (otomatis dari APP_URL).
# VITE_DEV_SERVER_HOST=192.168.100.249

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database PostgreSQL ---
DB_CONNECTION=pgsql

# PC utama (.249) — Postgres lokal:
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=Absensi_qdesign
DB_USERNAME=postgres
DB_PASSWORD=

# PC dev (.100) — Postgres remote di .249:
# DB_HOST=192.168.100.249
# DB_PORT=5433

# Wajib UTC — ESP32 kirim event_time ISO UTC (…Z).
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
